    <!-- http://www.semanticweb.org/hp/ontologies/2026/2/WebSemantica/correspondeA -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2026/2/WebSemantica/correspondeA">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">corresponds to</rdfs:label>
        <skos:prefLabel xml:lang="en">corresponds to</skos:prefLabel>
        <skos:altLabel xml:lang="en">maps to</skos:altLabel>
        <rdfs:label xml:lang="es">corresponde a</rdfs:label>
        <skos:prefLabel xml:lang="es">corresponde a</skos:prefLabel>
        <skos:altLabel xml:lang="es">se asocia a</skos:altLabel>
        <rdfs:label xml:lang="de">entspricht</rdfs:label>
        <skos:prefLabel xml:lang="de">entspricht</skos:prefLabel>
        <skos:altLabel xml:lang="de">ist zugeordnet zu</skos:altLabel>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/2/WebSemantica/correspondeA"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/2/WebSemantica/eventoDeportivo"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/2/WebSemantica/correspondeA"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/2/WebSemantica/Deporte"/>
            </owl:Restriction>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/2/WebSemantica/seRealizaEn -->

